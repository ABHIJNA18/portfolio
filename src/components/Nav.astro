---
import { site } from '../data/site';

const links = [
  { label: 'Work', href: '#work' },
  { label: 'Projects', href: '#projects' },
  { label: 'Education', href: '#education' },
  { label: 'Books', href: '#books' },
  { label: 'Music', href: '#music' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="logo">{site.fullName}<span>.</span></a>
    <div class="nav-right">
      <nav aria-label="Sections">
        <ul>
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path></svg
        >
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .nav.scrolled {
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }

  .logo {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1;
    text-decoration: none;
  }

  .logo span {
    color: var(--accent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  ul {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  ul a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  ul a:hover {
    color: var(--ink);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--muted);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .i-sun,
  :global([data-theme='dark']) .i-moon {
    display: none;
  }

  :global([data-theme='dark']) .i-sun {
    display: block;
  }

  @media (max-width: 600px) {
    nav {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const nav = document.querySelector('.nav');

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
