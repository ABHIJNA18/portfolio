---
import Section from './Section.astro';
import BookCover from './BookCover.astro';
import ShelfBook from './ShelfBook.astro';
import { books } from '../data/books';

const reading = books.filter((book) => book.status === 'reading');
const shelves = [
  { label: 'Favorites', books: books.filter((book) => book.status === 'loved') },
  { label: 'Up next', books: books.filter((book) => book.status === 'up-next') },
].filter((shelf) => shelf.books.length > 0);
---

<Section id="books" tone="sunset" num="04" title="Bookshelf" intro="What I'm reading now, what I've loved, and what's next on the pile.">
  {
    reading.length > 0 && (
      <div class="group">
        <h3 class="sub">Currently reading</h3>
        <ul class="reading">
          {reading.map((book) => (
            <li class="reading-card reveal">
              <div class="reading-cover">
                <BookCover book={book} sizes="96px" />
              </div>
              <div>
                <p class="reading-title">{book.title}</p>
                <p class="author">{book.author}</p>
                {book.progress != null && (
                  <>
                    <div
                      class="progress"
                      role="progressbar"
                      aria-label={`Progress through ${book.title}`}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow={book.progress}
                    >
                      <span style={`width: ${book.progress}%`} />
                    </div>
                    <p class="progress-label">{book.progress}% through</p>
                  </>
                )}
                {book.note && <p class="note">{book.note}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    shelves.length > 0 && (
      <div class="shelf reveal" data-shelf>
        <div class="shelf-row">
          {shelves.map((shelf, i) => (
            <>
              {i > 0 && <span class="bookend" aria-hidden="true" />}
              <div class="shelf-group">
                <h3 class="sub">{shelf.label}</h3>
                <div class="shelf-books">
                  {shelf.books.map((book) => (
                    <ShelfBook book={book} />
                  ))}
                </div>
              </div>
            </>
          ))}
          <svg class="plant" viewBox="0 0 80 120" aria-hidden="true">
            <path d="M40 78C38 58 26 44 10 40c10 12 18 24 22 38z" fill="#6f9a72" />
            <path d="M40 78c2-22 14-38 32-44-10 14-20 28-24 44z" fill="#4f7d5a" />
            <path d="M40 78c-1-26 4-50 14-66 0 22-4 44-10 66z" fill="#5f8b6e" />
            <path d="M40 78c-4-18-12-30-26-36 8 12 14 22 18 36z" fill="#3f6f52" />
            <path d="M18 76h44l-5 42H23z" fill="#c96f4a" />
            <path d="M16 72h48v8H16z" rx="2" fill="#b35f3d" />
          </svg>
        </div>
        <div class="plank" aria-hidden="true" />
      </div>
    )
  }
</Section>

<style>
  .reading {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-card {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 520px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }

  .reading-cover {
    flex: none;
    width: 96px;
  }

  .reading-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.1;
  }

  .author {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  .progress {
    height: 4px;
    margin-top: 16px;
    border-radius: 4px;
    background: var(--line);
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  .progress-label {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .note {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }


  /* ---------- The shelf ---------- */
  .shelf {
    --plank: #cdbb9e;
    --plank-top: #ddd0b8;
    margin-top: 64px;
  }

  :global([data-theme='dark']) .shelf {
    --plank: #3b342b;
    --plank-top: #4a4237;
  }

  .shelf-row {
    display: flex;
    align-items: flex-end;
    gap: 28px;
    min-height: 250px;
    padding: 0 14px;
  }

  .shelf-group .sub {
    margin-bottom: 14px;
  }

  .shelf-books {
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }

  .bookend {
    flex: none;
    width: 8px;
    height: 120px;
    border-radius: 4px 4px 0 0;
    background: color-mix(in srgb, var(--ink) 55%, var(--bg));
  }

  .plant {
    flex: none;
    width: 70px;
    margin-left: auto;
  }

  .plank {
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(var(--plank-top), var(--plank));
    box-shadow: 0 12px 18px -12px rgb(0 0 0 / 0.45);
  }


  @media (max-width: 560px) {
    .shelf {
      --book-scale: 0.82;
    }

    .shelf-row {
      gap: 18px;
      min-height: 215px;
      padding: 0 6px;
    }

    .plant {
      display: none;
    }
  }
</style>

<script>
  // One book off the shelf at a time; Esc puts it back.
  const books = [...document.querySelectorAll<HTMLButtonElement>('[data-shelf] .shelf-book')];

  const open = (target: HTMLButtonElement | null) => {
    for (const book of books) {
      const isTarget = book === target;
      book.classList.toggle('is-open', isTarget);
      book.setAttribute('aria-expanded', String(isTarget));
    }
  };

  for (const book of books) {
    book.addEventListener('click', () => open(book.classList.contains('is-open') ? null : book));
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') open(null);
  });
</script>
